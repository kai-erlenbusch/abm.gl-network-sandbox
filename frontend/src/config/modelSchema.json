{
  "name": "Ant Colony GPU",
  "controls": [
    { "type": "button", "id": "setup", "label": "Setup" },
    { "type": "toggle", "id": "go", "label": "Go" },
    { "type": "slider", "id": "model_speed", "label": "Model Speed", "min": 0.0, "max": 10.0, "step": 0.1, "default": 1.0 },
    { "type": "number", "id": "agent_count", "label": "Ant Count", "min": 1, "max": 100000, "step": 100, "default": 125 },
    { "type": "slider", "id": "world_size", "label": "World Size", "min": 10.0, "max": 200.0, "step": 5.0 },
    { "type": "slider", "id": "interaction_radius", "label": "Smell Radius", "min": 0.05, "max": 5.0, "step": 0.05 },
    { "type": "slider", "id": "evaporation_rate", "label": "Evaporation Rate", "min": 0.0, "max": 1.0, "step": 0.01 },
    { "type": "slider", "id": "diffusion_rate", "label": "Diffusion Rate", "min": 0.0, "max": 1.0, "step": 0.01 },
    { "type": "slider", "id": "pheromone_drop_rate", "label": "Pheromone Drop Rate", "min": 1.0, "max": 100.0, "step": 1.0 }
  ],
  "plots": [
    { "id": "telemetry", "title": "Food In Nest" }
  ],
  "monitors": [
    { "id": "macro_engine", "label": "Macro Engine", "value": "Shachi (Python LLM)" }
  ]
}
